# --- Core services (same for every deployment) ---
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime
AGENT_VOICE=alloy

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+15551234567

# Public hostname Twilio can reach this server at (no https://, no trailing slash)
# e.g. your-app.onrender.com, or the ngrok host while testing locally.
PUBLIC_HOSTNAME=

PORT=3000

# --- Per-client sales pitch (change these for every business you sell to) ---
BUSINESS_NAME=Acme Co
AGENT_NAME=Alex
PRODUCT_PITCH=a service that helps small businesses save time and win more customers
PRICING=starting at $99/month, no long-term contract
TARGET_CUSTOMER=small business owners
OBJECTION_NOTES=If they say it is too expensive, mention the free trial. If they say they need to think about it, offer to text info and schedule a follow-up.
CALENDAR_LINK=https://cal.com/your-client/demo

# Gets a text after every call with a summary of what happened
OWNER_PHONE=+15557654321

# Optional: also POST each captured lead as JSON to this URL (Zapier, CRM, etc.)
LEADS_WEBHOOK_URL=
