# Stripe — use TEST MODE keys (dashboard toggle top-right, "Test mode").
# Secret key: Dashboard > Developers > API keys > Secret key (starts with sk_test_)
STRIPE_SECRET_KEY=

# Webhook signing secret, from `stripe listen` (Stripe CLI) or a configured
# webhook endpoint in the dashboard (starts with whsec_). Optional in this
# dev environment — /success confirms payment directly as a fallback.
STRIPE_WEBHOOK_SECRET=

# Anthropic API key for the AI food-idea generator.
# Get one at https://console.anthropic.com/settings/keys
